{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/applications(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/riders(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/passengers(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/trips(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/admin/(applications|riders|passengers|trips|moolre|activity|audit|stats|health)(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
